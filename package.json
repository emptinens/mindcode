{
  "name": "mindcode",
  "version": "0.1.0",
  "description": "MindCode CLI",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "src/entrypoints/cli.tsx",
  "bin": {
    "mindcode": "src/entrypoints/cli.tsx"
  },
  "scripts": {
    "build": "node scripts/build-bundle.mjs",
    "build:watch": "node scripts/build-bundle.mjs --watch",
    "build:prod": "node scripts/build-bundle.mjs --minify",
    "build:web": "bun scripts/build-web.ts",
    "build:web:watch": "bun scripts/build-web.ts --watch",
    "build:web:prod": "bun scripts/build-web.ts --minify",
    "typecheck": "node scripts/quality-baseline.mjs typecheck",
    "typecheck:strict": "tsc --noEmit",
    "lint": "node scripts/quality-baseline.mjs lint",
    "lint:strict": "biome lint src/",
    "lint:fix": "biome lint --write src/",
    "format": "biome format --write src/",
    "sources:clean": "node scripts/strip-inline-source-maps.mjs",
    "sources:check": "node scripts/strip-inline-source-maps.mjs --check",
    "check": "bun run lint && bun run typecheck",
    "quality-baseline:update": "node scripts/quality-baseline.mjs update",
    "test": "bun test --isolate",
    "coverage:changed": "bun test --isolate --coverage --coverage-reporter=lcov && node scripts/coverage-changed.mjs",
    "coverage:changed:gate": "node scripts/coverage-changed.mjs",
    "smoke": "bun dist/mindcode.js --help"
  },
  "dependencies": {
    "@alcalzone/ansi-tokenize": "^0.3.0",
    "@commander-js/extra-typings": "^13.1.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.57.0",
    "@opentelemetry/sdk-logs": "^0.57.0",
    "@opentelemetry/sdk-metrics": "^1.30.0",
    "@opentelemetry/sdk-trace-base": "^1.30.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-unicode11": "^0.8.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "asciichart": "^1.5.25",
    "auto-bind": "^5.0.1",
    "axios": "^1.7.0",
    "bidi-js": "^1.0.3",
    "bun-pty": "^0.4.10",
    "chalk": "^5.4.0",
    "chokidar": "^4.0.0",
    "cli-boxes": "^3.0.0",
    "code-excerpt": "^4.0.0",
    "diff": "^7.0.0",
    "env-paths": "^4.0.0",
    "execa": "^9.5.0",
    "fflate": "^0.8.2",
    "figures": "^6.1.0",
    "fuse.js": "^7.0.0",
    "highlight.js": "^11.11.0",
    "https-proxy-agent": "^9.0.0",
    "ignore": "^6.0.0",
    "indent-string": "^5.0.0",
    "jsonc-parser": "^3.3.1",
    "lodash-es": "^4.17.21",
    "lru-cache": "^11.3.6",
    "marked": "^15.0.0",
    "node-pty": "^1.1.0",
    "p-map": "^7.0.0",
    "picomatch": "^4.0.0",
    "proper-lockfile": "^4.1.2",
    "qrcode": "^1.5.0",
    "react": "^19.0.0",
    "react-reconciler": "^0.31.0",
    "semver": "^7.6.0",
    "shell-quote": "^1.8.3",
    "ssh2": "^1.15.0",
    "stack-utils": "^2.0.6",
    "strip-ansi": "^7.1.0",
    "supports-hyperlinks": "^3.1.0",
    "tree-kill": "^1.2.2",
    "turndown": "^7.2.4",
    "type-fest": "^4.30.0",
    "undici": "^7.3.0",
    "usehooks-ts": "^3.1.0",
    "vscode-jsonrpc": "^8.2.1",
    "wrap-ansi": "^9.0.0",
    "wreq-js": "^2.3.1",
    "ws": "^8.18.0",
    "xss": "^1.0.15",
    "yaml": "^2.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/bun": "^1.3.14",
    "@types/diff": "^7.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.10.0",
    "@types/picomatch": "^3.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.0.0",
    "@types/semver": "^7.5.8",
    "@types/ssh2": "^1.15.0",
    "@types/stack-utils": "^2.0.3",
    "@types/ws": "^8.5.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "packageManager": "bun@1.1.0"
}
